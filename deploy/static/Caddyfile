# Static server for apps/landing and apps/web. TLS ends at Cloudflare and the host nginx
# (deploy/production/nginx.conf); this listens on plain :8080 as an unprivileged user. No `log` directive, so no access
# logs and no client IPs are ever written.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	header {
		import /etc/caddy/csp.caddy
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Content-hashed build output (Next `_next/static`, Astro `_astro`) never changes.
	@hashed path /_next/static/* /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /_next/static/* /_astro/*
	header @other Cache-Control "public, max-age=300"

	try_files {path} {path}/index.html {path}.html
	file_server {
		precompressed br gzip
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
