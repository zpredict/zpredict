---
import "@fontsource/jetbrains-mono/latin-500.css";
import mono from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
	title?: string;
	description?: string;
	/** Show the loading counter (the page must render <Preloader />). */
	preloader?: boolean;
}

const { title = site.title, description = site.description, preloader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);
---

<!doctype html>
<html lang="en" data-preload={preloader ? "" : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- Cascade layer order must be declared before any bundled CSS; see styles/global.css. -->
		<style is:inline>
			@layer reset, ui;
		</style>
		<!--
			Before first paint: the artboard scales (no jump once the bundle runs) and, unless motion
			is reduced, the preloader. The timeout releases the page even if the bundle never runs.
		-->
		<script is:inline>
			(() => {
				const d = document.documentElement;
				const w = innerWidth;
				const h = innerHeight;
				d.style.setProperty("--composition-scale", String(Math.min(w / 1600, h / 1000)));
				d.style.setProperty("--content-scale", String(Math.min(w / 1600, h / 1000)));
				// Mirrors --frame-size in components/hero/ModelFrame.astro.
				d.style.setProperty("--snap-scale", String(((w <= 900 ? 0.96 : 0.8) * Math.min(w, h)) / 741.6));
				if (d.hasAttribute("data-preload") && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
					d.classList.add("is-loading");
					setTimeout(() => d.classList.remove("is-loading"), 4000);
				}
			})();
		</script>
		<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
		<!--
			Google Analytics 4 (#226), production builds only. This site and the docs only: the app
			(app.zpredict.site) contacts no third party. The CSP allows GA's origins here alone
			(deploy/static/prepare.mjs --analytics) and hashes the inline config.
		-->
		{
			import.meta.env.PROD && (
				<Fragment>
					<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-W949LN2MSJ" />
					<script is:inline>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", "G-W949LN2MSJ");
					</script>
				</Fragment>
			)
		}
		<slot name="head" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="referrer" content="no-referrer" />
		<meta name="theme-color" content="#050505" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="zPredict" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<!-- Theme-aware favicon, per packages/brand/README.md -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon-32x32.png" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/white/favicon-32x32.png" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
	</head>
	<body>
		<slot />
	</body>
</html>
