---
/**
 * "How it works": four steps pinned for 400svh like the template's process section. The active
 * step follows scroll (scripts/how-steps.ts) and switches the mono terminal panel on the right.
 * Phones and reduced motion: not pinned; tapping a step selects it.
 */
import { steps } from "../data/steps";
import Section from "./ui/Section.astro";
import Title from "./ui/Title.astro";
import ZecIcon from "./ui/ZecIcon.astro";

/** `**x**` → lime. */
const segments = (line: string) => line.split("**").map((text, i) => ({ text, hot: i % 2 === 1 }));
---

<Section id="how" tone="paper" class="how js-how">
	<div class="pin">
		<div class="grid">
			<Title class="heading" lines={["How it", "works."]} />
			<ol class="steps">
				{
					steps.map((step, i) => (
						<li>
							<button
								class="step js-step"
								type="button"
								aria-current={i === 0 ? "step" : "false"}
								aria-controls="how-screen"
							>
								<span class="marker" aria-hidden="true" />
								<span>
									<span class="step-title">
										{step.title.split("ZEC").map((part, k) => (
											<>
												{k > 0 && (
													<>
														<ZecIcon />
														ZEC
													</>
												)}
												{part}
											</>
										))}
									</span>
									<span class="copy">{step.text}</span>
								</span>
							</button>
						</li>
					))
				}
			</ol>
			<div id="how-screen" class="visual">
				{
					steps.map((step, i) => (
						<div class:list={["screen js-screen", { "is-active": i === 0 }]}>
							{step.panel.map((line) => (
								// One line, so no template whitespace lands inside the pre-formatted span.
								<span class="ln">{segments(line).map((s) => (s.hot ? <b>{s.text}</b> : s.text))}</span>
							))}
						</div>
					))
				}
			</div>
		</div>
	</div>
</Section>

<script>
	import "../scripts/how-steps";
</script>

<style>
	.how {
		height: 400svh;
		padding: 0;
	}
	.how > :global(.wrap) {
		height: 100%;
	}
	.pin {
		position: sticky;
		top: 0;
		display: grid;
		align-content: center;
		height: 100svh;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: calc(56px * var(--content-scale)) calc(120px * var(--content-scale));
	}
	.heading {
		grid-column: 1 / -1;
	}
	.steps {
		display: grid;
		gap: calc(26px * var(--content-scale));
		align-content: center;
	}
	.step {
		display: flex;
		gap: 16px;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		color: #61655a;
		text-align: left;
		cursor: pointer;
		transition:
			color 450ms ease,
			transform 450ms ease;
	}
	.step[aria-current="step"] {
		color: var(--zp-ink);
		transform: translateX(calc(14px * var(--content-scale)));
	}
	.marker {
		flex: none;
		width: max(8px, calc(12px * var(--content-scale)));
		height: max(8px, calc(12px * var(--content-scale)));
		margin-top: 0.45em;
		background: var(--zp-lime);
		outline: 1px solid var(--zp-ink);
		transition: transform 450ms ease;
	}
	.step[aria-current="step"] .marker {
		transform: rotate(12deg);
	}
	.step-title {
		display: block;
		margin-bottom: 6px;
		font-size: calc(22px * var(--content-scale));
		letter-spacing: -0.04em;
		line-height: 1.2;
	}
	.copy {
		display: block;
	}
	.visual {
		position: relative;
		align-self: center;
		aspect-ratio: 4 / 3;
		background: var(--zp-bg);
		color: var(--zp-text);
	}
	.screen {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 8%;
		overflow: hidden;
		font-size: max(12px, calc(15px * var(--content-scale)));
		line-height: 1.7;
		white-space: pre;
		opacity: 0;
		transform: scale(1.04);
		transition:
			opacity 650ms ease,
			transform 1.2s var(--zp-ease);
	}
	.screen.is-active {
		opacity: 1;
		transform: none;
	}
	.ln {
		min-height: 1.7em;
	}
	.screen b {
		color: var(--zp-lime);
		font-weight: inherit;
	}

	@media (max-width: 900px), (prefers-reduced-motion: reduce) {
		.how {
			height: auto;
			padding: 72px 0;
		}
		.pin {
			position: static;
			height: auto;
		}
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.visual {
			order: 1;
		}
		.steps {
			order: 2;
			gap: 22px;
		}
		.step {
			color: var(--zp-ink);
			transform: none;
		}
		.step[aria-current="step"] {
			transform: none;
		}
		.step-title {
			font-size: 22px;
		}
		.screen {
			padding: 5%;
			font-size: 12px;
		}
	}
</style>
