---
/** A Privacy Policy or Terms page from data/legal.ts: note, summary, numbered sections. */
import { type LegalDoc, NOTE } from "../data/legal";
import Footer from "./Footer.astro";
import Logo from "./ui/Logo.astro";

interface Props {
	doc: LegalDoc;
}

const { doc } = Astro.props;
---

<header class="top" id="top">
	<Logo href="/" />
</header>
<main class="legal">
	<p class="eyebrow">zPredict · last updated {doc.updated}</p>
	<h1 class="title"><span>{doc.title}</span></h1>
	<p class="note">{NOTE}</p>
	<p class="summary">{doc.summary}</p>
	<ol class="sections">
		{
			doc.sections.map((s) => (
				<li>
					<h2>{s.heading}</h2>
					{s.paragraphs.map((p) => (
						<p>
							{p.map((seg) => (typeof seg === "string" ? seg : <a href={seg.href}>{seg.text}</a>))}
						</p>
					))}
				</li>
			))
		}
	</ol>
</main>
<Footer />

<style>
	.top {
		padding: 28px var(--zp-gutter) 0;
	}
	.legal {
		display: grid;
		gap: 24px;
		max-width: 760px;
		margin: 0 auto;
		padding: 56px var(--zp-gutter) 96px;
		box-sizing: content-box;
		font-size: 14px;
		line-height: 1.7;
	}
	.eyebrow {
		color: var(--zp-muted);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.title span {
		padding: 0 7px;
		background: var(--zp-lime);
		color: var(--zp-bg);
		font-size: clamp(26px, 4vw, 40px);
		line-height: 1.4;
		letter-spacing: -0.04em;
	}
	.note {
		padding: 12px 14px;
		border: 1px dashed var(--zp-lime);
		color: var(--zp-text);
		font-size: 13px;
	}
	.summary {
		font-size: 16px;
	}
	.sections {
		display: grid;
		gap: 28px;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: sec;
	}
	.sections li {
		display: grid;
		gap: 10px;
		padding-top: 20px;
		border-top: 1px solid rgb(255 255 255 / 0.12);
		counter-increment: sec;
	}
	h2 {
		font-size: 18px;
		letter-spacing: -0.02em;
	}
	h2::before {
		content: counter(sec, decimal-leading-zero) " / ";
		color: var(--zp-lime);
	}
	.sections p {
		color: var(--zp-muted);
	}
	.legal a {
		color: var(--zp-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.legal a:hover {
		color: var(--zp-lime);
	}
	@media (max-width: 680px) {
		.legal {
			padding: 40px var(--zp-gutter) 72px;
		}
	}
</style>
