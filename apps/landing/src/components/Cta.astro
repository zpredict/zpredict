---
import { site } from "../data/site";
import CtaButton from "./ui/CtaButton.astro";
import Section from "./ui/Section.astro";

const lines = ["Bet without", "being seen."];
---

<Section tone="dark" class="finale">
	<h2 class="heading" aria-label={lines.join(" ")} data-scramble="continuous">
		{
			lines.map((line) => (
				<span class="row">
					<span class="strip" aria-hidden="true" data-scramble-line>
						{line}
					</span>
				</span>
			))
		}
	</h2>
	<p class="muted lede">
		Pick a market and a side. One click gets you real testnet ZEC from our faucet; nothing to install.
	</p>
	<CtaButton class="button" href={site.appUrl} label={site.cta} />
</Section>

<style>
	.finale {
		text-align: center;
	}
	.heading {
		display: block;
		width: fit-content;
		margin: 0 auto;
		color: var(--zp-bg);
		font-size: clamp(30px, calc(56px * var(--content-scale)), 64px);
		line-height: 1.4;
		letter-spacing: -0.04em;
	}
	.row {
		display: block;
	}
	.strip {
		display: inline-block;
		padding: 0 0.25em;
		background: var(--zp-lime);
	}
	.lede {
		max-width: 44ch;
		margin: 28px auto 36px;
	}
</style>
