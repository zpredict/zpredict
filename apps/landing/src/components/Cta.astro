---
import { site } from "../data/site";
import Button from "./ui/Button.astro";
import MotionVideo from "./ui/MotionVideo.astro";
import Panel from "./ui/Panel.astro";
import SectionHeading from "./ui/SectionHeading.astro";
---

<Panel class="finale">
	<MotionVideo class="video" src="/media/hero.mp4" poster="/media/hero-poster.webp" />
	<div class="content">
		<SectionHeading lines={["Bet without", "being seen"]} />
		<p class="lede lede--center">Pick a market and a side. Judge mode includes a prefunded testnet wallet; nothing to install.</p>
		<Button variant="cta" href={site.appUrl}>Open the app</Button>
	</div>
</Panel>

<style>
	.finale {
		overflow: hidden;
		text-align: center;
		padding-block: clamp(90px, 14vw, 200px);
	}
	.video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.55;
	}
	.content {
		position: relative;
	}
</style>
