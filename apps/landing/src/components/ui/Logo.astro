---
/** White zPredict mark from packages/brand, linking to the top of the page. */
---

<a class="logo" href="#top" aria-label="zPredict home">
	<img src="/white/android-chrome-192x192.png" alt="" width="46" height="46" />
</a>

<style>
	@layer ui {
		.logo {
			display: block;
			width: 46px;
			height: 46px;
		}
		.logo img {
			width: 100%;
			height: 100%;
		}
	}
</style>
