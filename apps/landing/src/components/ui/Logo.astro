---
/** White mark from packages/brand plus the lime wordmark; `filter: brightness(0)` turns both black on light surfaces. */
interface Props {
	class?: string;
	/** Defaults to the top of the current page. */
	href?: string;
}

const { class: className, href = "#top" } = Astro.props;
---

<a class:list={["logo", className]} href={href} aria-label="zPredict home">
	<img src="/white/android-chrome-192x192.png" alt="" width="40" height="40" />
	<span aria-hidden="true">zPredict</span>
</a>

<style>
	@layer ui {
		.logo {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			height: var(--zp-control-h);
			color: var(--zp-lime);
			font-size: 22px;
			letter-spacing: -0.04em;
		}
		.logo img {
			width: 40px;
			height: 40px;
		}
		@media (max-width: 900px) {
			.logo {
				gap: 8px;
				font-size: 18px;
			}
			.logo img {
				width: 32px;
				height: 32px;
			}
		}
	}
</style>
