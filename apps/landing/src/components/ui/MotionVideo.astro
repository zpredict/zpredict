---
/**
 * Muted looping background video, poster first. The file is not even requested until
 * motion-video.ts decides to play it (wide screen, on screen, motion allowed, page loaded);
 * otherwise the poster is all anyone downloads.
 */
interface Props {
	src: string;
	poster: string;
	class?: string;
}

const { src, poster, class: className } = Astro.props;
---

<video
	class:list={["js-motion", className]}
	muted
	loop
	playsinline
	preload="none"
	poster={poster}
	data-src={src}
	aria-hidden="true"
></video>

<script>
	import "../../scripts/motion-video";
</script>
