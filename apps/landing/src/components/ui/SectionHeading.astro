---
/** Uppercase display heading; each entry in `lines` is one hard line. */
interface Props {
	lines: string[];
	align?: "center" | "left";
	class?: string;
}

const { lines, align = "center", class: className } = Astro.props;
---

<h2 class:list={["heading", `heading--${align}`, className]}>
	{lines.map((line, i) => (i === 0 ? line : [<br />, line]))}
</h2>

<style>
	@layer ui {
		.heading {
			font-family: var(--font-display);
			font-weight: 500;
			font-size: clamp(44px, 7vw, 96px);
			line-height: 0.9;
			letter-spacing: -0.05em;
			text-transform: uppercase;
			margin-bottom: clamp(28px, 4vw, 56px);
		}
		.heading--center {
			text-align: center;
		}
		.heading--left {
			text-align: left;
		}
	}
</style>
