---
/** Decorative hairline circle; gradients are defined once in Base.astro. */
interface Props {
	size: number;
	fade?: "down" | "up";
	class?: string;
}

const { size, fade = "down", class: className } = Astro.props;
const c = size / 2;
---

<svg class:list={["ring", className]} viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
	<circle
		cx={c}
		cy={c}
		r={c - 0.5}
		fill="none"
		stroke={fade === "down" ? "url(#ringDown)" : "url(#ringUp)"}></circle>
</svg>

<style>
	@layer ui {
		.ring {
			overflow: visible;
			pointer-events: none;
		}
	}
</style>
