---
/** Template orbit: two rings around a glass badge with the bolt. */
import Ring from "../ui/Ring.astro";
---

<Ring size={505} class="ring outer" />
<Ring size={265} class="ring inner" />
<div class="badge">
	<div class="badge__inner">
		<img class="bolt" src="/media/bolt.svg" alt="" />
	</div>
</div>

<style>
	.outer {
		top: 10px;
		width: 460px;
	}
	.inner {
		top: 70px;
		width: 220px;
	}
	.badge {
		top: 135px;
		display: grid;
		place-items: center;
		width: 103px;
		height: 103px;
		border: 1px solid var(--glass-line);
		border-radius: 50%;
		background: var(--glass-fill);
		box-shadow: 0 32px 43px -13px rgba(0, 0, 0, 0.48);
		-webkit-backdrop-filter: blur(27.3px);
		backdrop-filter: blur(27.3px);
	}
	.badge__inner {
		display: grid;
		place-items: center;
		width: 82px;
		height: 82px;
		border: 1px solid var(--glass-line);
		border-radius: 50%;
		background: var(--glass-fill);
	}
	.bolt {
		width: 38px;
		height: 38.52px;
	}
</style>
