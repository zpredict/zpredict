---
/** Three glass chips, one XOR share each. */
import Ring from "../ui/Ring.astro";

const shares = ["9f3a·c1e0", "27bd·04af", "e86c·b55d"];
---

<Ring size={481} class="ring" />
<div class="shares">
	{shares.map((share) => <code>{share}</code>)}
</div>

<style>
	.shares {
		top: 100px;
		display: grid;
		gap: 10px;
	}
	code {
		display: block;
		padding: 12px 18px;
		border: 1px solid var(--glass-line);
		border-radius: 14px;
		background: var(--glass-fill);
		font-size: 15px;
		letter-spacing: 0.04em;
		color: rgba(255, 255, 255, 0.75);
		box-shadow: 0 32px 43px -13px rgba(0, 0, 0, 0.48);
	}
	code:nth-child(2) {
		transform: translateX(18px);
	}
	code:nth-child(3) {
		transform: translateX(-12px);
	}
</style>
