---
/** Template globe video fading into the card, under an upward ring. */
import MotionVideo from "../ui/MotionVideo.astro";
import Ring from "../ui/Ring.astro";
---

<MotionVideo class="globe" src="/media/globe.mp4" poster="/media/globe-poster.jpg" />
<div class="fade"></div>
<Ring size={481} fade="up" class="ring up" />

<style>
	.globe {
		top: 0;
		width: 300px;
		mix-blend-mode: screen;
	}
	.fade {
		top: 0;
		width: 100%;
		height: 300px;
		background: linear-gradient(180deg, rgba(25, 26, 26, 0) 40%, #171818 100%);
	}
	.up {
		top: 120px;
	}
</style>
