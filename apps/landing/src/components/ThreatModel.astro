---
import { threats, thresholds } from "../data/threats";
import Panel from "./ui/Panel.astro";
import SectionHeading from "./ui/SectionHeading.astro";
---

<Panel id="threat-model">
	<SectionHeading lines={["Threat", "model"]} />
	<div class="stats">
		{
			thresholds.map((t) => (
				<div class="stat">
					<span class="stat__value">{t.value}</span>
					<span class="stat__label">{t.label}</span>
				</div>
			))
		}
	</div>
	<p class="lede lede--center">What each party can and can't learn, stated up front.</p>
	<div class="table-wrap">
		<table>
			<thead>
				<tr><th scope="col">Observer</th><th scope="col">Learns</th><th scope="col">Doesn't learn</th></tr>
			</thead>
			<tbody>
				{
					threats.map((row) => (
						<tr>
							<th scope="row">{row.observer}</th>
							<td data-label="Learns">
								{row.learns.map((s) => (typeof s === "string" ? s : <strong>{s.em}</strong>))}
							</td>
							<td data-label="Doesn't learn">{row.hidden}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</Panel>

<style>
	.stats {
		display: flex;
		justify-content: center;
		gap: var(--gap);
		margin-bottom: 28px;
	}
	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: min(260px, 44%);
		padding: 28px 20px;
		border: 1px solid var(--hairline);
		border-radius: var(--r-pane);
		background: var(--surface-card);
	}
	.stat__value {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(40px, 5vw, 72px);
		line-height: 1;
		letter-spacing: -0.05em;
	}
	.stat__label {
		margin-top: 10px;
		font-size: 15px;
		opacity: 0.6;
		text-align: center;
	}
	.table-wrap {
		max-width: 1100px;
		margin: 0 auto;
		overflow-x: auto;
		border: 1px solid var(--hairline);
		border-radius: var(--r-pane);
		background: var(--surface-card);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 16px;
		line-height: 1.35;
	}
	th,
	td {
		padding: 18px 22px;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--hairline);
	}
	tr:last-child > * {
		border-bottom: 0;
	}
	thead th {
		font-weight: 400;
		font-size: 14px;
		opacity: 0.5;
	}
	tbody th {
		font-family: var(--font-display);
		font-weight: 500;
		white-space: nowrap;
	}
	td:last-child {
		opacity: 0.65;
	}

	/* Phones: each row becomes a stacked block with inline labels. */
	@media (max-width: 799.98px) {
		.stats {
			flex-direction: column;
			align-items: stretch;
		}
		table {
			font-size: 15px;
		}
		thead {
			display: none;
		}
		tr {
			display: block;
			padding: 16px 18px;
			border-bottom: 1px solid var(--hairline);
		}
		tr:last-child {
			border-bottom: 0;
		}
		th,
		td {
			display: block;
			padding: 0;
			border: 0;
		}
		td {
			margin-top: 8px;
		}
		td::before {
			content: attr(data-label);
			display: block;
			font-size: 12px;
			opacity: 0.5;
		}
	}
</style>
