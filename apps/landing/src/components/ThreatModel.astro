---
import { site } from "../data/site";
import { threats, thresholds } from "../data/threats";
import Section from "./ui/Section.astro";
import Title from "./ui/Title.astro";
---

<Section id="threat-model" tone="paper">
	<div class="layout">
		<div class="intro">
			<Title lines={["Threat", "model."]} />
			<p class="muted lede">
				What each party can and can't learn, stated up front, including the limits of this hosted demo.
				Evidence for every row is in <a href={`${site.repoUrl}/blob/main/PRIVACY.md`}>PRIVACY.md</a>.
			</p>
			<div class="stats">
				{
					thresholds.map((t) => (
						<p class="stat">
							<span class="value">{t.value}</span>
							<span class="label">{t.label}</span>
						</p>
					))
				}
			</div>
		</div>
		<div class="table-wrap">
			<table>
				<thead>
					<tr><th scope="col">Observer</th><th scope="col">Learns</th><th scope="col">Doesn't learn</th></tr>
				</thead>
				<tbody>
					{
						threats.map((row) => (
							<tr>
								<th scope="row">{row.observer}</th>
								<td data-label="Learns">
									{row.learns.map((s) => (typeof s === "string" ? s : <strong>{s.em}</strong>))}
								</td>
								<td class="muted" data-label="Doesn't learn">
									{row.hidden}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</Section>

<style>
	.layout {
		display: grid;
		grid-template-columns: 480fr 800fr;
		gap: calc(120px * var(--content-scale));
		align-items: start;
	}
	.lede {
		margin-top: 24px;
	}
	.lede a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
		max-width: calc(400px * var(--content-scale));
		margin-top: 32px;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px;
		background: var(--zp-lime);
	}
	.value {
		font-size: clamp(28px, calc(40px * var(--content-scale)), 40px);
		line-height: 1;
		letter-spacing: -0.06em;
	}
	.label {
		color: var(--zp-ink-2);
		font-size: 12px;
		line-height: 1.4;
	}
	table {
		width: 100%;
		border-collapse: collapse;
	}
	th,
	td {
		padding: calc(22px * var(--content-scale)) 16px calc(22px * var(--content-scale)) 0;
		border-bottom: 1px solid var(--zp-rule-on-lime);
		text-align: left;
		vertical-align: top;
	}
	thead th {
		color: var(--zp-ink-2);
		font-weight: inherit;
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	tbody th {
		font-weight: inherit;
		white-space: nowrap;
	}
	strong {
		font-weight: inherit;
		background: var(--zp-lime);
		padding: 0 4px;
	}
	@media (max-width: 1100px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.stats {
			max-width: 480px;
		}
	}
	/* Phones: each row becomes a stacked block with inline labels. */
	@media (max-width: 680px) {
		thead {
			display: none;
		}
		tr {
			display: block;
			padding: 16px 0;
			border-bottom: 1px solid var(--zp-rule-on-lime);
		}
		th,
		td {
			display: block;
			padding: 0;
			border: 0;
		}
		td {
			margin-top: 8px;
		}
		td::before {
			content: attr(data-label);
			display: block;
			color: var(--zp-ink-2);
			font-size: 11px;
			letter-spacing: 0.04em;
			text-transform: uppercase;
		}
	}
</style>
