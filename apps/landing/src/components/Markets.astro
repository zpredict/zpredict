---
import { sampleMarkets } from "../data/markets";
import { site } from "../data/site";
import Panel from "./ui/Panel.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Tag from "./ui/Tag.astro";

const price = (percent: number) => (percent / 100).toFixed(2);
---

<Panel id="markets">
	<SectionHeading lines={["Live", "markets"]} />
	<p class="lede lede--center">
		Questions the Zcash community already argues about, resolved from chain data.
	</p>
	<div class="markets">
		{
			sampleMarkets.map((m) => (
				<a class="market" href={site.appUrl}>
					<Tag class="tag">Testnet</Tag>
					<h3 class="question">{m.question}</h3>
					<p class="rule">Resolves on: {m.rule}</p>
					<div class="bar" style={`--yes:${m.yes}%`}>
						<span>YES {price(m.yes)}</span>
						<span>NO {price(100 - m.yes)}</span>
					</div>
				</a>
			))
		}
	</div>
	<p class="note note--center">Prices shown are illustrative. Live prices are in the app.</p>
</Panel>

<style>
	.markets {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--gap);
	}
	.market {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 28px;
		border: 1px solid var(--hairline);
		border-radius: var(--r-pane);
		background: var(--surface-card);
		transition: border-color 0.2s ease;
	}
	.market:hover {
		border-color: rgba(255, 255, 255, 0.3);
	}
	.tag {
		margin-bottom: 20px;
	}
	.question {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 24px;
		line-height: 1.1;
		letter-spacing: -0.04em;
	}
	.rule {
		margin: 14px 0 28px;
		font-size: 14px;
		opacity: 0.5;
	}
	.bar {
		display: flex;
		justify-content: space-between;
		width: 100%;
		margin-top: auto;
		padding: 12px 14px;
		border-radius: 12px;
		font-family: var(--font-mono);
		font-size: 13px;
		background: linear-gradient(
			90deg,
			rgba(255, 255, 255, 0.18) var(--yes),
			rgba(255, 255, 255, 0.04) var(--yes)
		);
	}

	@media (max-width: 1199.98px) {
		.markets {
			grid-template-columns: 1fr;
			max-width: 640px;
			margin: 0 auto;
		}
	}
</style>
