---
import { markets } from "../data/markets";
import MarketCard from "./markets/MarketCard.astro";
import Section from "./ui/Section.astro";
import Title from "./ui/Title.astro";
---

<Section id="markets" tone="dark">
	<div class="layout">
		<div class="intro">
			<Title lines={["Live", "markets."]} />
			<p class="muted lede">
				Questions the Zcash community already argues about. Each one resolves from a block anyone can
				check.
			</p>
			<p class="muted note">
				The markets the testnet relayers serve right now, one per resolver in the repo. Prices are public
				and live in the app; who traded never is.
			</p>
		</div>
		<div class="grid">
			{markets.map((market) => <MarketCard market={market} />)}
		</div>
	</div>
</Section>

<style>
	.layout {
		display: grid;
		grid-template-columns: 400fr 880fr;
		gap: calc(120px * var(--content-scale));
		align-items: start;
	}
	.intro {
		position: sticky;
		top: max(140px, calc(170px * var(--content-scale)));
	}
	.lede {
		max-width: calc(400px * var(--content-scale));
		margin-top: 24px;
	}
	.note {
		max-width: calc(400px * var(--content-scale));
		margin-top: 16px;
		font-size: 12px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	@media (max-width: 1100px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.intro {
			position: static;
		}
		.lede,
		.note {
			max-width: 40em;
		}
	}
	@media (max-width: 680px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
