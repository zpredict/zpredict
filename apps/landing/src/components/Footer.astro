---
import { site } from "../data/site";
import Button from "./ui/Button.astro";
import Logo from "./ui/Logo.astro";
---

<footer class="footer">
	<Logo />
	<p>Built for Zecathon 2026 · MIT</p>
	<Button variant="pill" href={site.repoUrl}>GitHub</Button>
</footer>

<style>
	.footer {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 28px var(--pad) 18px;
		font-size: 15px;
	}
	p {
		margin-right: auto;
		opacity: 0.5;
	}
	@media (max-width: 799.98px) {
		.footer {
			flex-wrap: wrap;
		}
	}
</style>
