---
import { site } from "../data/site";
import Logo from "./ui/Logo.astro";
---

<footer class="footer" data-surface="dark">
	<Logo />
	<p>Built for Zecathon 2026 · MIT</p>
	<a class="repo" href="/pitch/">Watch the 2-min pitch</a>
	<a class="repo" href={site.docsUrl}>Docs</a>
	<a class="repo" href={site.repoUrl}>GitHub</a>
</footer>

<style>
	.footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 24px;
		padding: 28px var(--zp-gutter);
		border-top: 1px solid rgb(255 255 255 / 0.12);
		color: var(--zp-muted);
		font-size: 13px;
	}
	p {
		margin-right: auto;
	}
	.repo {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 16px;
		border: 1px solid rgb(255 255 255 / 0.24);
		color: var(--zp-text);
		text-transform: uppercase;
		transition: border-color 250ms ease;
	}
	.repo:hover {
		border-color: var(--zp-lime);
	}
</style>
