---
/** Brushed-metal bet ticket; stands in for the template's payment card. */
interface Props {
	market: string;
	price: string;
	class?: string;
}

const { market, price, class: className } = Astro.props;
---

<div class:list={["ticket", className]} aria-hidden="true">
	<img class="mark" src="/white/android-chrome-192x192.png" alt="" />
	<span class="label">{market}</span>
	<span class="price">{price}</span>
	<span class="side">Your side ● ● ● ●</span>
</div>

<style>
	.ticket {
		position: relative;
		display: flex;
		flex-direction: column;
		width: min(301px, 60%);
		aspect-ratio: 301 / 423;
		padding: 9% 9% 10%;
		border-radius: 37px;
		text-align: left;
		color: #111;
		background:
			repeating-linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.06) 0 1px,
				transparent 1px 3px
			),
			linear-gradient(
				105deg,
				#6f7072 0%,
				#e6e7e8 22%,
				#8e8f91 38%,
				#f4f4f5 52%,
				#7c7d80 70%,
				#cfd0d2 86%,
				#6a6b6d 100%
			);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.6),
			0 40px 60px -20px rgba(0, 0, 0, 0.7);
		transform-style: preserve-3d;
	}
	.mark {
		width: 44px;
		height: 44px;
		filter: invert(1);
		opacity: 0.85;
	}
	.label {
		margin-top: auto;
		font-size: 14px;
		opacity: 0.6;
	}
	.price {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(30px, 3vw, 42px);
		line-height: 1;
		letter-spacing: -0.05em;
	}
	.side {
		margin-top: 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		opacity: 0.55;
	}
</style>
