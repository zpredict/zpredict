---
/**
 * The core object of a prediction market, square and mono: question, chance, YES/NO prices,
 * probability bar and sparkline, plus what stays hidden on zPredict.
 */
import { categoryOf, type Market } from "../../data/markets";
import { site } from "../../data/site";
import Sparkline from "./Sparkline.astro";

interface Props {
	market: Market;
	class?: string;
}

const { market, class: className } = Astro.props;
const no = 100 - market.yes;
const height = market.resolveHeight.toLocaleString("en-US");
---

<article class:list={["market", className]}>
	<header class="top">
		<span class="category">{categoryOf[market.plugin]}</span>
		<span class="height">Block {height}</span>
	</header>

	<h3 class="question">{market.question}</h3>

	<div class="odds">
		<p class="chance"><span class="pct">{market.yes}%</span> chance</p>
		<Sparkline class="spark" points={market.history} />
	</div>
	<div class="bar" aria-hidden="true"><span style={`width:${market.yes}%`}></span></div>

	<div class="prices">
		<a class="price price--yes" href={site.appUrl} aria-label={`Buy Yes ${market.yes}¢`}>
			Yes <strong>{market.yes}¢</strong>
		</a>
		<a class="price price--no" href={site.appUrl} aria-label={`Buy No ${no}¢`}>
			No <strong>{no}¢</strong>
		</a>
	</div>

	<footer class="meta">
		<span>Bettors: hidden</span>
		<span>Sizes: hidden</span>
		<span>Resolved from chain data</span>
	</footer>
</article>

<style>
	.market {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 22px;
		border: 1px solid rgb(255 255 255 / 0.12);
		background: var(--zp-bg);
		font-size: 13px;
		transition: border-color 250ms ease;
	}
	.market:hover {
		border-color: var(--zp-lime);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.category {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--zp-text);
	}
	.category::before {
		content: "";
		width: 8px;
		height: 8px;
		background: var(--zp-lime);
	}
	.height {
		color: var(--zp-muted);
		white-space: nowrap;
	}
	.question {
		font-size: 17px;
		line-height: 1.35;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.odds {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		margin-top: auto;
	}
	.chance {
		color: var(--zp-muted);
		white-space: nowrap;
	}
	.pct {
		margin-right: 4px;
		color: var(--zp-lime);
		font-size: 40px;
		line-height: 1;
		letter-spacing: -0.06em;
	}
	.spark {
		width: 46%;
		height: 36px;
	}
	.bar {
		height: 4px;
		background: rgb(255 255 255 / 0.08);
	}
	.bar span {
		display: block;
		height: 100%;
		background: var(--zp-lime);
	}
	.prices {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
	}
	.price {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 14px;
		font-size: 14px;
		text-transform: uppercase;
		transition:
			background-color 250ms ease,
			color 250ms ease,
			border-color 250ms ease;
	}
	.price strong {
		font-weight: inherit;
	}
	.price--yes {
		background: var(--zp-lime);
		color: var(--zp-ink);
	}
	.price--yes:hover {
		background: var(--zp-paper);
	}
	.price--no {
		border: 1px solid rgb(255 255 255 / 0.24);
	}
	.price--no:hover {
		border-color: var(--zp-text);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 14px;
		color: var(--zp-muted);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
</style>
