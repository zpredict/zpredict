---
/**
 * A live market, square and mono: question, resolve height, YES/NO links into the app, plus
 * what stays hidden on zPredict. No price: the live one is in the app.
 */
import { categoryOf, type Market, resolvedBy } from "../../data/markets";
import { site } from "../../data/site";

interface Props {
	market: Market;
	class?: string;
}

const { market, class: className } = Astro.props;
const trade = (side: string) => `${site.appUrl}/trade/?m=${market.id}&side=${side}`;
---

<article class:list={["market", className]}>
	<header class="top">
		<span class="category">{categoryOf[market.plugin]}</span>
		<span class="height">{market.resolve}</span>
	</header>

	<h3 class="question">{market.question}</h3>

	<p class="live">Live price in the app</p>

	{
		market.id === undefined ? (
			<div class="prices prices--one">
				<a class="price price--yes" href={`${site.appUrl}/`}>
					This hour's market <span aria-hidden="true">→</span>
				</a>
			</div>
		) : (
			<div class="prices">
				<a class="price price--yes" href={trade("yes")} aria-label={`Trade Yes: ${market.question}`}>
					Yes <span aria-hidden="true">→</span>
				</a>
				<a class="price price--no" href={trade("no")} aria-label={`Trade No: ${market.question}`}>
					No <span aria-hidden="true">→</span>
				</a>
			</div>
		)
	}

	<footer class="meta">
		<span>Bettors: hidden</span>
		<span>Sizes: hidden</span>
		<span>{resolvedBy(market)}</span>
	</footer>
</article>

<style>
	.market {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 22px;
		border: 1px solid rgb(255 255 255 / 0.12);
		background: var(--zp-bg);
		font-size: 13px;
		transition: border-color 250ms ease;
	}
	.market:hover {
		border-color: var(--zp-lime);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.category {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--zp-text);
	}
	.category::before {
		content: "";
		width: 8px;
		height: 8px;
		background: var(--zp-lime);
	}
	.height {
		color: var(--zp-muted);
		white-space: nowrap;
	}
	.question {
		font-size: 17px;
		line-height: 1.35;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.live {
		margin-top: auto;
		color: var(--zp-muted);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.prices {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
	}
	.prices--one {
		grid-template-columns: 1fr;
	}
	.price {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 14px;
		font-size: 14px;
		text-transform: uppercase;
		transition:
			background-color 250ms ease,
			color 250ms ease,
			border-color 250ms ease;
	}
	.price--yes {
		background: var(--zp-lime);
		color: var(--zp-ink);
	}
	.price--yes:hover {
		background: var(--zp-paper);
	}
	.price--no {
		border: 1px solid rgb(255 255 255 / 0.24);
	}
	.price--no:hover {
		border-color: var(--zp-text);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 14px;
		color: var(--zp-muted);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
</style>
