---
import Section from "./ui/Section.astro";
import Title from "./ui/Title.astro";

const relayers = ["A", "B", "C"];
---

<Section id="relayer-view" tone="dark">
	<div class="layout">
		<div class="intro">
			<p class="eyebrow">Relayer view</p>
			<Title lines={["What a", "relayer sees."]} />
			<p class="muted lede">
				Your bet leaves the browser as three random shares, one per relayer. Each one sees noise; only
				all three together, inside MPC, can match it.
			</p>
			<p class="muted note">Illustration. The app shows the live shares.</p>
		</div>

		<div class="relayers" role="group" aria-label="Three relayers, each holding a random share">
			{
				relayers.map((name) => (
					<div class="relayer">
						<p class="head">
							<span>Relayer {name}</span>
							<span class="live">share</span>
						</p>
						<pre class="share js-share" aria-hidden="true" />
					</div>
				))
			}
			<div class="you">
				<p class="head"><span>You, after a fill</span></p>
				<p class="plain">YES · 71¢ · 5 units · filled</p>
			</div>
		</div>
	</div>
</Section>

<script>
	import "../scripts/relayer-noise";
</script>

<style>
	.layout {
		display: grid;
		grid-template-columns: 480fr 800fr;
		gap: calc(120px * var(--content-scale));
		align-items: center;
	}
	.eyebrow {
		margin-bottom: 16px;
		color: var(--zp-lime);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.lede {
		max-width: calc(400px * var(--content-scale));
		margin-top: 24px;
	}
	.note {
		margin-top: 16px;
		font-size: 12px;
	}
	.relayers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}
	.relayer {
		padding: 18px;
		border: 1px solid rgb(255 255 255 / 0.12);
	}
	.head {
		display: flex;
		justify-content: space-between;
		margin-bottom: 14px;
		color: var(--zp-muted);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.live {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--zp-lime);
	}
	.live::before {
		content: "";
		width: 6px;
		height: 6px;
		background: currentColor;
	}
	.share {
		min-height: 5.6em;
		color: var(--zp-glyph);
		font-size: 12px;
		line-height: 1.4;
		white-space: pre-wrap;
		word-break: break-all;
	}
	.you {
		grid-column: 1 / -1;
		padding: 18px;
		background: var(--zp-lime);
		color: var(--zp-ink);
	}
	.you .head {
		color: var(--zp-ink-2);
	}
	.plain {
		font-size: clamp(18px, 1.8vw, 26px);
		letter-spacing: -0.04em;
	}
	@media (max-width: 1100px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.lede {
			max-width: 40em;
		}
	}
	@media (max-width: 680px) {
		.relayers {
			grid-template-columns: 1fr;
		}
	}
</style>
