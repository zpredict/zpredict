---
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PublicVsPrivate from "../components/PublicVsPrivate.astro";
import RelayerView from "../components/RelayerView.astro";
import ThreatModel from "../components/ThreatModel.astro";
import TrendingMarkets from "../components/TrendingMarkets.astro";
import Base from "../layouts/Base.astro";
---

<Base>
	<!-- Hero poster: the LCP image on every screen size. -->
	<link slot="head" rel="preload" href="/media/hero-poster.webp" as="image" fetchpriority="high" />
	<main>
		<Hero />
		<TrendingMarkets />
		<PublicVsPrivate />
		<HowItWorks />
		<RelayerView />
		<ThreatModel />
		<Cta />
	</main>
	<Footer />
</Base>
