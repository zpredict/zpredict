{
	"name": "@zpredict/landing",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare:deps": "pnpm --filter @zpredict/ascii build && node scripts/copy-brand.mjs",
		"dev": "pnpm prepare:deps && astro dev",
		"build": "pnpm prepare:deps && astro build && node scripts/smoke.mjs && node ../web/scripts/privacy.mjs dist",
		"preview": "astro preview",
		"test": "node --test scripts/legal.test.mjs"
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@zpredict/ascii": "workspace:*",
		"@zpredict/brand": "workspace:*",
		"astro": "^7.4.2"
	}
}
