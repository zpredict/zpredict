{
	"name": "@zpredict/docs",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "zPredict documentation, docs.zpredict.site",
	"scripts": {
		"postinstall": "fumadocs-mdx",
		"brand": "node scripts/brand.mjs",
		"predev": "pnpm brand",
		"prebuild": "pnpm brand",
		"dev": "next dev -p 3002",
		"build": "next build && node scripts/privacy.mjs",
