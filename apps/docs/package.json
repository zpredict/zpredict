		"lint:links": "node scripts/lint-links.mts",
		"test": "pnpm lint:links && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@zpredict/brand": "workspace:*",
		"fumadocs-core": "16.17.7",
