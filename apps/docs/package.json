		"fumadocs-ui": "16.17.7",
		"next": "^16.4.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"takumi-js": "2.5.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"next-validate-link": "1.6.6",
		"postcss": "8.5.25",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.3"
	}
