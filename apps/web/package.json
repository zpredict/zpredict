{
	"name": "@zpredict/web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"prepare:deps": "pnpm --filter @zpredict/sdk build && node scripts/brand.mjs",
		"predev": "pnpm prepare:deps",
		"prebuild": "pnpm prepare:deps",
		"dev": "next dev -p 3000",
		"build": "next build && node scripts/privacy.mjs",
		"mock": "pnpm --filter @zpredict/sdk build && node mock-relayer/src/server.mjs",
		"dev:mock": "pnpm prepare:deps && node scripts/dev-mock.mjs",
		"test": "pnpm --filter @zpredict/sdk build && node --test mock-relayer/src/clearing.test.mjs"
	},
	"dependencies": {
		"@fontsource/figtree": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@zpredict/sdk": "workspace:*",
		"next": "^16.4.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^5.9.3"
	}
}
